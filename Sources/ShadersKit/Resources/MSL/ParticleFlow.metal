        col = mixColors(((*prm)).colA, ((*prm)).colB, clamp(agitAvg, 0.0f, 1.0f));
    }
    const float curA = ((energyCoverageAlpha(energy, 1.6f) * col.w));
    const float4 out_ = particleFlowResolveTrailComposite(col, curA, idx);
    trailBuf[idx] = out_;
    outTex.write(out_, uint2(x, y));
}
