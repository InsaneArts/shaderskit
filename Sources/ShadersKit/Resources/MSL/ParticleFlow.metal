    const float eRaw = float(atomic_load_explicit((&accumE[idx]), memory_order_relaxed));
    atomic_store_explicit((&accumE[idx]), 0u, memory_order_relaxed);
    const float sRaw = float(atomic_load_explicit((&accumS[idx]), memory_order_relaxed));
    atomic_store_explicit((&accumS[idx]), 0u, memory_order_relaxed);
    const float energy = particleFlowResolveEnergy(eRaw);
    float4 col = ((*prm)).colA;
    if ((((eRaw > 0.0f)))) {
